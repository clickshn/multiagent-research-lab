# .dockerignore — 빌드 컨텍스트에서 제외할 것 (ADR-010)
#
# 여기 빠뜨린 파일은 이미지 **레이어**에 들어간다. 레이어는 나중에 지워도
# 이미지 히스토리에 남고, 이미지를 받는 사람은 누구나 꺼내 볼 수 있다.
# 그래서 이 파일은 편의가 아니라 **보안 경계**다.
#
# 관련: docs/governance.md "시크릿 취급" / "로컬 산출물 취급", ADR-009 Review Trigger.

# ---------------------------------------------------------------------------
# 1. 시크릿 — 절대 들어가면 안 된다
# ---------------------------------------------------------------------------
# VLLM_BASE URL은 인증이 없어 **URL을 아는 것이 곧 접근 권한**이다.
# .env는 COPY하지 않고 런타임에 docker-compose의 env_file로만 주입한다.
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# 2. 런타임 산출물 — 프롬프트/응답 **평문**이 쌓이는 경로
# ---------------------------------------------------------------------------
# var/llm_cache/ : LLM 응답 본문이 평문 JSON으로 (ADR-008)
# var/traces/    : 프롬프트를 포함한 감사 로그가 (ADR-007)
# var/chroma/    : 인덱싱된 문서 본문이
# 이미지에 굽지 않고 docker-compose에서 named volume으로 마운트한다.
var/

# ---------------------------------------------------------------------------
# 3. 빌드에 불필요 — 이미지 크기와 캐시 무효화를 줄인다
# ---------------------------------------------------------------------------
.git/
.gitattributes
.gitignore
.github/

# 로컬 전용 에이전트 설정. CLAUDE.md는 개인 메모라 배포물에 들어갈 이유가 없다.
CLAUDE.md
.claude/

# 가상환경 / 캐시
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# 가중치는 빌드 **안에서** 고정 리비전으로 받는다 (scripts/fetch_model.py).
# 호스트에 받아둔 것을 COPY하면 리비전 보증이 깨진다 — 무엇이 들어갔는지 알 수 없다.
vendor/
models/
*.gguf
*.safetensors
*.bin

# 에디터 / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# 컨테이너 정의 자체는 이미지 안에 필요 없다
Dockerfile
docker-compose.yml
.dockerignore
