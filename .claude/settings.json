{
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(aws:*)",
      "PowerShell(terraform apply:*)",
      "PowerShell(aws:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/load-handoff.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check-deploy-approval.sh" }
        ]
      }
    ]
  }
}
