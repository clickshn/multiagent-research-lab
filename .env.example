# .env.example — 키 이름만 공유하는 템플릿. 실제 값은 .env에 두고 커밋하지 않는다.
# 사용법: cp .env.example .env 후 실제 값을 채운다.

# OpenAI 호환 vLLM 엔드포인트 (끝에 /v1 포함)
VLLM_BASE=https://your-endpoint/v1

# 엔드포인트가 서빙하는 모델 이름
VLLM_MODEL=your-model-name

# 엔드포인트가 인증을 요구하는 경우에만 설정. 없으면 비워둔다.
VLLM_API_KEY=

# --- 임베딩 / 벡터 DB (ADR-005) ---
# 비워두면 intfloat/multilingual-e5-small을 쓴다. 바꾸면 인덱스를 다시 만들어야 한다
# (`python scripts/build_index.py --reset`).
EMBEDDING_MODEL=
EMBEDDING_DEVICE=cpu

# 가중치 리비전(HuggingFace git 커밋 해시). **비워두는 것이 정상이다** — 기본 모델의
# 리비전은 `infra/model-pin.json`에 고정돼 있고 코드가 거기서 읽는다 (ADR-011).
# `EMBEDDING_MODEL`을 다른 모델로 바꿨다면 그 모델의 리비전을 여기 직접 넣어야 한다.
# 비워두고 모델만 바꾸면 고정이 풀린 채로 돈다 (= 런타임에 HuggingFace latest를 받는다).
EMBEDDING_REVISION=

# 미리 내려받은 가중치 디렉터리. 채워지면 네트워크를 타지 않고 이 경로에서 읽는다.
# 컨테이너는 이미지에 구운 경로를 쓰므로 Dockerfile이 이 값을 설정한다 —
# 호스트 `.env`에서는 보통 비워둔다. 로컬에 미리 받아두려면:
#   python scripts/fetch_model.py          # vendor/models/... 에 받고 sha256 검증
EMBEDDING_LOCAL_PATH=

# Chroma 영속 경로 / 컬렉션 이름. 비워두면 var/chroma, research_corpus.
CHROMA_DIR=
CHROMA_COLLECTION=

# --- 계측 (ADR-007) ---
# 셋을 모두 채우면 Langfuse로도 전송한다. 비워두면 로컬 JSONL만 기록한다.
# 관측 데이터를 외부 SaaS로 내보내지 않는다는 제약상, self-host 주소만 넣는다.
#
# docker-compose의 langfuse 프로파일을 쓰는 경우 (session-06에 실측 검증됨):
#   docker compose --profile langfuse up -d
#   LANGFUSE_HOST=http://langfuse:3000     ← 컨테이너 네트워크 안에서의 이름
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-dev    ← 컨테이너가 기동 시 자동 생성하는 키
#   LANGFUSE_SECRET_KEY=sk-lf-local-dev
# 호스트에서 직접 돌린다면 HOST는 http://localhost:3000 이다.
# 위 키는 **로컬 개발 전용**이다. 배포 환경에서는 반드시 새로 발급한다.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 계측 로그 경로. 비워두면 var/traces.
TRACE_LOG_DIR=

# --- LLM 응답 캐시 (ADR-008) ---
# 기본은 꺼짐이다. 캐시가 켜져 있으면 "하네스 개선"과 "캐시 적중"을 구분할 수 없어
# 측정이 왜곡된다. 재현 실행(데모, 문서 작성)에만 켠다.
# 켜려면 1 / true / yes / on 중 하나.
LLM_CACHE=

# 캐시 저장 경로. 비워두면 var/llm_cache (커밋 대상 아님).
LLM_CACHE_DIR=
